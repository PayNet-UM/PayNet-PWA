# Copy to .env.local (staging) and .env.production (production), then fill in the values.
# Firebase web config: Firebase console > Project settings > General > Your apps
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Comma-separated MPP admin emails. Use a real mailbox: admins must verify their email.
MPP_ADMIN_EMAILS=
