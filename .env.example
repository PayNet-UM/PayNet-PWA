# Copy to .env.local (staging) and .env.production (production), then fill in the values.
# Firebase web config: Firebase console > Project settings > General > Your apps
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Comma-separated HEP admin emails. Use a real mailbox: admins must verify their email.
MPP_ADMIN_EMAILS=

# Optional: Google Maps browser key (Maps JavaScript API) and Map ID. Leave empty to use the free OpenStreetMap map.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Optional: custom domains (connect them in Firebase Hosting first). Leave empty to use the .web.app addresses.
CLIENT_URL=
ADMIN_URL=
