 app/js/views/auth.js | 14 ++++++++++----
 functions/index.js   | 10 ++++++++--
 3 files changed, 22 insertions(+), 6 deletions(-)

diff --git a/app/js/i18n-ms.js b/app/js/i18n-ms.js
index d53bdbd..46d0937 100644
